# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).

# === Cấu hình cho cả `python run.py` và ứng dụng web ===
# MODEL_PROVIDER / AI_PROVIDER: fake (mặc định, chạy offline không cần API key) | openai | disabled
MODEL_PROVIDER=fake
MODEL_NAME=gpt-4o-mini
API_KEY=

AI_PROVIDER=fake
OPENAI_BASE_URL=https://api.openai.com/v1
AI_BUDGET_USD_PER_PROJECT=1.00
AI_MAX_TOKENS=800
AI_TIMEOUT_S=30
AI_MAX_RETRIES=2

# === Cấu hình Database & Bảo mật Local ===
DATABASE_URL=sqlite:///./.local_data/app.db
UPLOAD_STORAGE_DIR=./.local_data/uploads
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# === Giới hạn đọc Excel an toàn ===
MAX_UPLOAD_MB=10
MAX_FILES_PER_BATCH=10
MAX_SHEETS=30
MAX_ROWS=10000
MAX_COLS=200

# === Tùy chọn khởi tạo Admin lần đầu qua CLI (`python -m backend.cli create-admin`) ===
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
